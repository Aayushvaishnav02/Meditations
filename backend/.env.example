# Copy to .env and adjust. All values optional; defaults suit local Ollama.

# AI provider: "openai_compatible" (Ollama, OpenRouter, Groq, vLLM, OpenAI) or "anthropic"
AI_PROVIDER=openai_compatible
AI_MODEL_NAME=llama3.2:3b
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama

# SQLite database location (relative to backend/ or absolute)
JOURNAL_DB_PATH=data/journal.db
